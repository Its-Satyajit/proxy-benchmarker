{
  "name": "proxy-benchmarker",
  "version": "1.0.0",
  "description": "Proxy benchmark and network finder for local networks",
  "type": "module",
  "main": "update-proxies.ts",
  "scripts": {
    "start": "nub update-proxies.ts",
    "benchmark": "nub update-proxies.ts",
    "launcher": "nub launcher.ts",
    "typecheck": "tsc --noEmit",
    "build": "esbuild update-proxies.ts --bundle --platform=node --format=esm --minify --outfile=dist/proxy-benchmarker.min.mjs"
  },
  "keywords": [
    "proxy",
    "tester",
    "benchmark",
    "socks5",
    "socks4",
    "http",
    "https",
    "typescript"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.6.2",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
