{
  "name": "proxy-benchmarker",
  "version": "1.0.0",
  "description": "Asynchronous network telemetry and proxy performance benchmarking suite",
  "type": "module",
  "main": "update-proxies.ts",
  "scripts": {
    "start": "node dist/server.js",
    "serve": "nub src/server.ts",
    "benchmark": "nub update-proxies.ts",
    "launcher": "nub launcher.ts",
    "typecheck": "tsc --noEmit",
    "build:bundle": "esbuild update-proxies.ts --bundle --platform=node --format=esm --minify --outfile=dist/proxy-benchmarker.min.mjs",
    "build:server": "esbuild src/server.ts --bundle --platform=node --format=esm --outfile=dist/server.js --packages=external",
    "build": "esbuild update-proxies.ts --bundle --platform=node --format=esm --minify --outfile=dist/proxy-benchmarker.min.mjs && esbuild src/server.ts --bundle --platform=node --format=esm --outfile=dist/server.js --packages=external"
  },
  "keywords": [
    "proxy",
    "tester",
    "benchmark",
    "socks5",
    "socks4",
    "http",
    "https",
    "typescript"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.6.2",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@octokit/rest": "^22.0.1",
    "bullmq": "^6.3.8",
    "ioredis": "^6.0.0"
  }
}
